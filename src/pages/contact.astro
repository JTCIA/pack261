---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Cub Scout Pack 261">

  <div class="bg-scout-blue py-12 px-4 text-white text-center">
    <h1 class="text-3xl font-bold mb-2">Contact Us</h1>
    <p class="text-blue-200">We'd love to hear from you</p>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-5 gap-10">

      <!-- Contact info -->
      <div class="md:col-span-2 space-y-6">
        <div>
          <h2 class="text-xl font-bold text-scout-blue mb-4">Get In Touch</h2>
          <p class="text-gray-600 text-sm leading-relaxed">
            Whether you're interested in joining Pack 261, have a question, or want to get involved as a volunteer leader, we'd love to connect.
          </p>
        </div>

        <div class="space-y-4">
          {[
            {
              icon: 'mail',
              label: 'General Inquiries',
              value: 'BSASELAPack261@gmail.com',
              href: 'mailto:BSASELAPack261@gmail.com',
            },
            {
              icon: 'calendar',
              label: 'Pack Meetings',
              value: '1st Tuesday, 7:00 PM',
              href: '/calendar',
            },
            {
              icon: 'map',
              label: 'Meeting Location',
              value: 'St. Ann Cafeteria\n4921 Meadowdale Street\nMetairie, LA',
              href: null,
            },
          ].map(({ icon, label, value, href }) => (
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 bg-scout-blue-pale rounded-lg flex items-center justify-center flex-shrink-0">
                {icon === 'mail' && (
                  <svg class="w-4 h-4 text-scout-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {icon === 'user' && (
                  <svg class="w-4 h-4 text-scout-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                )}
                {icon === 'calendar' && (
                  <svg class="w-4 h-4 text-scout-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
                {icon === 'map' && (
                  <svg class="w-4 h-4 text-scout-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                )}
              </div>
              <div>
                <div class="text-xs font-semibold text-gray-400 uppercase tracking-wide">{label}</div>
                {href ? (
                  <a href={href} class="text-sm text-scout-blue hover:underline whitespace-pre-line">{value}</a>
                ) : (
                  <p class="text-sm text-gray-700 whitespace-pre-line">{value}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Social / BSA links -->
        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Quick Links</h3>
          <div class="space-y-2">
            <a href="https://www.scouting.org/programs/cub-scouts/" target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-scout-blue-mid hover:text-scout-blue">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              About Cub Scouts — BSA
            </a>
            <a href="https://my.scouting.org" target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-scout-blue-mid hover:text-scout-blue">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Register / my.Scouting.org
            </a>
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div class="md:col-span-3">
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
          <h2 class="text-xl font-bold text-gray-900 mb-5">Send Us a Message</h2>

          <!-- Static form — wire up to Cloudflare Forms, Formspree, or similar -->
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            action="/contact?success=true"
            class="space-y-4"
            id="contact-form"
          >
            <input type="hidden" name="form-name" value="contact" />

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="first-name" class="block text-sm font-medium text-gray-700 mb-1">First name</label>
                <input type="text" id="first-name" name="first-name" required
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue focus:border-transparent" />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-gray-700 mb-1">Last name</label>
                <input type="text" id="last-name" name="last-name" required
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue focus:border-transparent" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
              <input type="email" id="email" name="email" required
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue focus:border-transparent" />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">What's this about?</label>
              <select id="subject" name="subject"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue focus:border-transparent">
                <option value="">Select a topic...</option>
                <option value="joining">Joining the pack</option>
                <option value="volunteering">Volunteering / becoming a leader</option>
                <option value="event">Question about an event</option>
                <option value="general">General question</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
              <textarea id="message" name="message" rows="5" required
                placeholder="Tell us a bit about yourself and how we can help..."
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue focus:border-transparent resize-y"></textarea>
            </div>

            <button type="submit"
              class="w-full bg-scout-blue text-white py-3 rounded-lg font-semibold hover:bg-scout-blue-mid transition-colors shadow-sm">
              Send Message
            </button>
          </form>

          <p class="text-xs text-gray-400 mt-4 text-center">
            We typically respond within 48 hours. For urgent matters, please email us directly.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
