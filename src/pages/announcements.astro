---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allAnnouncements = (await getCollection('announcements'))
  .sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  });

const categoryColors: Record<string, string> = {
  event: 'bg-blue-100 text-blue-800 border-blue-200',
  news: 'bg-green-100 text-green-800 border-green-200',
  fundraiser: 'bg-yellow-100 text-yellow-800 border-yellow-200',
  achievement: 'bg-purple-100 text-purple-800 border-purple-200',
  reminder: 'bg-red-100 text-red-800 border-red-200',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<Layout title="Announcements" description="Latest news and announcements from Cub Scout Pack 261">

  <div class="bg-scout-blue py-12 px-4 text-white text-center">
    <h1 class="text-3xl font-bold mb-2">Announcements</h1>
    <p class="text-blue-200">Stay up to date with Pack 261 news and events</p>
  </div>

  <!-- Category filter -->
  <div class="bg-white border-b border-gray-200 sticky top-16 z-10">
    <div class="max-w-4xl mx-auto px-4 py-3 flex gap-2 overflow-x-auto">
      <button data-filter="all" class="filter-btn active flex-shrink-0 px-3 py-1.5 rounded-full text-sm font-medium bg-scout-blue text-white border border-scout-blue transition-colors">
        All
      </button>
      {(['event', 'news', 'fundraiser', 'achievement', 'reminder'] as const).map((cat) => (
        <button data-filter={cat} class={`filter-btn flex-shrink-0 px-3 py-1.5 rounded-full text-sm font-medium border capitalize transition-colors hover:opacity-80 ${categoryColors[cat]}`}>
          {cat}
        </button>
      ))}
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div id="announcements-list" class="space-y-6">
      {allAnnouncements.map(async (post) => {
        const { Content } = await post.render();
        return (
          <article id={post.slug} data-category={post.data.category} class="announcement-card bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden scroll-mt-28">
            <div class="p-6">
              <div class="flex items-start justify-between gap-4 mb-3">
                <div class="flex items-center gap-2 flex-wrap">
                  {post.data.pinned && (
                    <span class="bg-scout-gold text-scout-blue text-xs font-semibold px-2.5 py-1 rounded-full flex items-center gap-1">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      Pinned
                    </span>
                  )}
                  <span class={`text-xs font-medium px-2.5 py-1 rounded-full border capitalize ${categoryColors[post.data.category]}`}>
                    {post.data.category}
                  </span>
                </div>
                <time class="text-sm text-gray-400 flex-shrink-0">{formatDate(post.data.date)}</time>
              </div>

              <h2 class="text-xl font-bold text-gray-900 mb-2">{post.data.title}</h2>
              <p class="text-gray-600 mb-4">{post.data.summary}</p>

              <!-- Expandable content -->
              <details class="group">
                <summary class="cursor-pointer text-scout-blue-mid hover:text-scout-blue text-sm font-medium flex items-center gap-1 list-none">
                  <svg class="w-4 h-4 group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  Read full announcement
                </summary>
                <div class="mt-4 pt-4 border-t border-gray-100 prose prose-sm max-w-none">
                  <Content />
                </div>
              </details>

              <p class="text-xs text-gray-400 mt-4">Posted by {post.data.author}</p>
            </div>
          </article>
        );
      })}
    </div>

    {allAnnouncements.length === 0 && (
      <div class="text-center py-16 text-gray-400">
        <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <p>No announcements yet. Check back soon!</p>
      </div>
    )}
  </div>

</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.announcement-card');

  // Auto-open and scroll to announcement when navigating via hash
  const hash = window.location.hash.slice(1);
  if (hash) {
    const target = document.getElementById(hash);
    if (target) {
      const details = target.querySelector('details');
      if (details) details.open = true;
      setTimeout(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      filterBtns.forEach(b => {
        b.classList.remove('bg-scout-blue', 'text-white', 'border-scout-blue', 'active');
        b.classList.add('bg-white');
      });
      btn.classList.add('bg-scout-blue', 'text-white', 'border-scout-blue', 'active');
      btn.classList.remove('bg-white');

      cards.forEach(card => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
