---
export const prerender = false;

import { COOKIE_NAME, makeToken } from '../../middleware.ts';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = (form.get('password') as string ?? '').trim();
  const adminPassword = import.meta.env.ADMIN_PASSWORD as string | undefined;

  if (!adminPassword) {
    // No password set — just let them in
    return Astro.redirect('/admin');
  }

  if (password === adminPassword) {
    const token = await makeToken(adminPassword);
    Astro.cookies.set(COOKIE_NAME, token, {
      path: '/',
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7, // 7 days
    });
    const redirect = Astro.url.searchParams.get('redirect') ?? '/admin';
    return Astro.redirect(redirect);
  }

  error = 'Incorrect password. Please try again.';
}

const noPassword = !import.meta.env.ADMIN_PASSWORD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Leader Login | Pack 261</title>
  </head>
  <body class="min-h-screen bg-gray-50 flex items-center justify-center p-4 font-sans">

    <div class="w-full max-w-sm">

      <!-- Logo / branding -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-scout-blue rounded-full mb-4">
          <span class="font-bold text-xl text-scout-gold">261</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Leader Portal</h1>
        <p class="text-sm text-gray-500 mt-1">Cub Scout Pack 261</p>
      </div>

      {noPassword && (
        <div class="mb-4 px-4 py-3 bg-yellow-50 border border-yellow-300 text-yellow-800 rounded-lg text-sm">
          <strong>Dev mode:</strong> <code class="font-mono bg-yellow-100 px-1 rounded">ADMIN_PASSWORD</code> is not set.
          <a href="/admin" class="underline font-medium ml-1">Enter without password →</a>
        </div>
      )}

      {error && (
        <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm flex items-center gap-2">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          {error}
        </div>
      )}

      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
        <form method="post" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input
              type="password"
              name="password"
              required
              autofocus
              class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
              placeholder="Enter leader password"
            />
          </div>
          <button
            type="submit"
            class="w-full py-2.5 rounded-lg text-sm font-semibold text-white bg-scout-blue hover:bg-scout-blue-mid transition-colors"
          >
            Sign In
          </button>
        </form>
      </div>

      <p class="text-center text-xs text-gray-400 mt-6">
        <a href="/" class="hover:text-gray-600 transition-colors">← Back to public site</a>
      </p>
    </div>

  </body>
</html>
