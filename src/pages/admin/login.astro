---
export const prerender = false;

const errorMessages: Record<string, string> = {
  not_authorized:    'Your GitHub account is not a collaborator on this repository.',
  oauth_failed:      'GitHub authentication failed. Please try again.',
  user_fetch_failed: 'Could not retrieve your GitHub profile. Please try again.',
};

const errorParam = Astro.url.searchParams.get('error') ?? '';
const error = errorMessages[errorParam] ?? (errorParam ? 'Authentication error. Please try again.' : '');

const redirect   = Astro.url.searchParams.get('redirect') ?? '/admin';
const githubUrl  = `/api/auth?mode=portal&redirect=${encodeURIComponent(redirect)}`;
const noSecret   = !import.meta.env.ADMIN_SECRET;
const noClientId = !import.meta.env.GITHUB_CLIENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Leader Login | Pack 261</title>
  </head>
  <body class="min-h-screen bg-gray-50 flex items-center justify-center p-4 font-sans">

    <div class="w-full max-w-sm">

      <!-- Branding -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-scout-blue rounded-full mb-4">
          <span class="font-bold text-xl text-scout-gold">261</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Leader Portal</h1>
        <p class="text-sm text-gray-500 mt-1">Cub Scout Pack 261</p>
      </div>

      {(noSecret || noClientId) && (
        <div class="mb-4 px-4 py-3 bg-yellow-50 border border-yellow-300 text-yellow-800 rounded-lg text-sm space-y-1">
          <p><strong>Setup required:</strong> Add these env vars in Cloudflare Workers:</p>
          <ul class="list-disc list-inside font-mono text-xs space-y-0.5 mt-1">
            {noClientId && <li>GITHUB_CLIENT_ID</li>}
            {noClientId && <li>GITHUB_CLIENT_SECRET</li>}
            {noSecret   && <li>ADMIN_SECRET (any random string)</li>}
          </ul>
          <a href="/admin" class="block mt-2 underline font-medium">Skip login (dev mode) →</a>
        </div>
      )}

      {error && (
        <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm flex items-start gap-2">
          <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          {error}
        </div>
      )}

      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
        <p class="text-sm text-gray-600 mb-4 text-center">
          Sign in with your GitHub account.<br />
          <span class="text-gray-400 text-xs">Access is granted to repository collaborators.</span>
        </p>
        <a href={githubUrl}
          class="flex items-center justify-center gap-3 w-full py-2.5 px-4 rounded-lg text-sm font-semibold bg-gray-900 text-white hover:bg-gray-700 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          Sign in with GitHub
        </a>
      </div>

      <p class="text-center text-xs text-gray-400 mt-6">
        <a href="/" class="hover:text-gray-600 transition-colors">← Back to public site</a>
      </p>
    </div>

  </body>
</html>
