---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Documents" activeSection="documents">

  <div class="flex items-center justify-between mb-6">
    <p class="text-sm text-gray-500">Pack forms, meeting notes, training materials, and other files</p>
    <div class="flex items-center gap-3">
      <span id="doc-status" class="text-xs text-gray-400"></span>
      <button id="upload-btn" class="flex items-center gap-1.5 text-sm bg-scout-blue text-white px-3 py-1.5 rounded-lg hover:bg-scout-blue-mid transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Upload
      </button>
    </div>
  </div>

  <!-- Search -->
  <div class="relative mb-6">
    <svg class="absolute left-3 top-2.5 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input type="search" id="doc-search" placeholder="Search documents…"
      class="w-full border border-gray-200 rounded-lg pl-9 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue bg-white" />
  </div>

  <!-- Document list -->
  <div id="doc-list" class="space-y-8">
    <p class="text-sm text-gray-400">Loading documents…</p>
  </div>

  <div id="no-results" class="hidden text-center py-12 text-gray-400">
    <svg class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="text-sm">No documents match your search.</p>
  </div>

  <!-- Upload modal -->
  <div id="upload-modal" class="hidden fixed inset-0 bg-black bg-opacity-40 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <h3 class="font-semibold text-gray-900">Upload Document</h3>
        <button id="close-upload-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form id="upload-form" class="p-5 space-y-4">
        <!-- Drop zone -->
        <div id="drop-zone"
          class="border-2 border-dashed border-gray-200 rounded-lg p-8 text-center cursor-pointer hover:border-scout-blue hover:bg-scout-blue-pale transition-colors">
          <svg class="w-8 h-8 mx-auto mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <p class="text-sm text-gray-500">Drop file here or <span class="text-scout-blue font-medium">browse</span></p>
          <p class="text-xs text-gray-400 mt-1">PDF, Word, Excel, PowerPoint, images, CSV, TXT — max 50 MB</p>
          <input type="file" id="file-input" class="hidden"
            accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.gif,.webp,.txt,.csv" />
        </div>
        <div id="file-preview" class="hidden flex items-center gap-3 bg-gray-50 rounded-lg px-3 py-2">
          <svg class="w-5 h-5 text-scout-blue flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <div class="flex-1 min-w-0">
            <p id="file-preview-name" class="text-sm font-medium text-gray-900 truncate"></p>
            <p id="file-preview-size" class="text-xs text-gray-500"></p>
          </div>
          <button type="button" id="clear-file" class="text-gray-400 hover:text-gray-600 flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Category <span class="text-red-400">*</span></label>
          <input type="text" id="upload-category" required list="category-options"
            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
            placeholder="e.g. Forms, Meeting Notes, Training" />
          <datalist id="category-options">
            <option value="Forms">
            <option value="Meeting Notes">
            <option value="Training">
            <option value="Planning">
            <option value="Camping">
            <option value="Finance">
          </datalist>
        </div>

        <!-- Upload progress -->
        <div id="upload-progress-wrap" class="hidden">
          <div class="flex justify-between text-xs text-gray-500 mb-1">
            <span>Uploading…</span>
            <span id="upload-pct">0%</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-1.5">
            <div id="upload-bar" class="bg-scout-blue h-1.5 rounded-full transition-all" style="width:0%"></div>
          </div>
        </div>

        <button type="submit" id="upload-submit"
          class="w-full bg-scout-blue text-white py-2 rounded-lg text-sm font-semibold hover:bg-scout-blue-mid transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
          Upload
        </button>
      </form>
    </div>
  </div>

</AdminLayout>

<script>
  interface Document {
    id: string;
    name: string;
    category: string;
    r2Key: string;
    size: number;
    contentType: string;
    uploadedAt: string;
  }

  let documents: Document[] = [];
  let currentSha = '';
  let searchQuery = '';
  let selectedFile: File | null = null;

  const statusEl = document.getElementById('doc-status')!;
  function setStatus(text: string, color: string) {
    statusEl.textContent = text;
    statusEl.className = `text-xs ${color}`;
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function formatDate(iso: string): string {
    try {
      return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return iso;
    }
  }

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function fileIcon(contentType: string): string {
    if (contentType === 'application/pdf') return 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z';
    if (contentType.startsWith('image/')) return 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z';
    if (contentType.includes('spreadsheet') || contentType.includes('excel') || contentType === 'text/csv') return 'M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z';
    return 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z';
  }

  function canPreviewInline(contentType: string): boolean {
    return contentType === 'application/pdf' || contentType.startsWith('image/') || contentType === 'text/plain';
  }

  // ── Load ──────────────────────────────────────────────────────────────────

  async function loadDocuments() {
    setStatus('Loading…', 'text-gray-400');
    try {
      const res = await fetch('/api/documents');
      const data = await res.json() as { documents: Document[]; sha: string; error?: string };
      if (!res.ok) throw new Error(data.error ?? `HTTP ${res.status}`);
      documents = data.documents;
      currentSha = data.sha;
      setStatus('', '');
    } catch (err) {
      setStatus('Failed to load', 'text-red-500');
      console.error(err);
    }
    renderDocuments();
  }

  // ── Render ────────────────────────────────────────────────────────────────

  function renderDocuments() {
    const container = document.getElementById('doc-list')!;
    const noResults = document.getElementById('no-results')!;
    const q = searchQuery.toLowerCase();

    const filtered = documents.filter(d =>
      !q || d.name.toLowerCase().includes(q) || d.category.toLowerCase().includes(q)
    );

    if (filtered.length === 0 && documents.length > 0) {
      container.innerHTML = '';
      noResults.classList.remove('hidden');
      return;
    }
    noResults.classList.add('hidden');

    if (documents.length === 0) {
      container.innerHTML = '<p class="text-sm text-gray-400">No documents yet. Click "Upload" to add your first file.</p>';
      return;
    }

    // Group by category
    const categoryOrder: string[] = [];
    const grouped: Record<string, Document[]> = {};
    for (const d of filtered) {
      if (!grouped[d.category]) { grouped[d.category] = []; categoryOrder.push(d.category); }
      grouped[d.category].push(d);
    }

    container.innerHTML = categoryOrder.map(cat => `
      <div>
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">${esc(cat)}</h2>
        <div class="space-y-2">
          ${grouped[cat].map(doc => `
            <div class="group flex items-center gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-gray-300 transition-colors">
              <div class="w-9 h-9 bg-scout-blue-pale rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-scout-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${fileIcon(doc.contentType)}" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate">${esc(doc.name)}</p>
                <p class="text-xs text-gray-400">${esc(formatBytes(doc.size))} &middot; ${esc(formatDate(doc.uploadedAt))}</p>
              </div>
              <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                ${canPreviewInline(doc.contentType) ? `
                  <a href="/api/documents/${esc(doc.id)}?disposition=inline" target="_blank" rel="noopener"
                    class="p-1.5 rounded-md text-gray-400 hover:text-scout-blue hover:bg-scout-blue-pale transition-colors" title="Open">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ` : ''}
                <a href="/api/documents/${esc(doc.id)}" download="${esc(doc.name)}"
                  class="p-1.5 rounded-md text-gray-400 hover:text-scout-blue hover:bg-scout-blue-pale transition-colors" title="Download">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                </a>
                <button data-id="${doc.id}" data-name="${esc(doc.name)}"
                  class="delete-doc-btn p-1.5 rounded-md text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors" title="Delete">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `).join('');

    container.querySelectorAll<HTMLButtonElement>('.delete-doc-btn').forEach(btn => {
      btn.addEventListener('click', () => deleteDocument(btn.dataset.id!, btn.dataset.name!));
    });
  }

  // ── Delete ────────────────────────────────────────────────────────────────

  async function deleteDocument(id: string, name: string) {
    if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
    setStatus('Deleting…', 'text-gray-400');
    try {
      const res = await fetch('/api/documents', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, sha: currentSha }),
      });
      const data = await res.json() as { ok: boolean; sha?: string; error?: string };
      if (!res.ok) throw new Error(data.error ?? `HTTP ${res.status}`);
      if (data.sha) currentSha = data.sha;
      documents = documents.filter(d => d.id !== id);
      setStatus('Deleted', 'text-green-600');
      setTimeout(() => setStatus('', ''), 2000);
    } catch (err) {
      setStatus('Delete failed', 'text-red-500');
      console.error(err);
    }
    renderDocuments();
  }

  // ── Search ────────────────────────────────────────────────────────────────

  document.getElementById('doc-search')?.addEventListener('input', e => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    renderDocuments();
  });

  // ── Upload modal ──────────────────────────────────────────────────────────

  const modal      = document.getElementById('upload-modal')!;
  const dropZone   = document.getElementById('drop-zone')!;
  const fileInput  = document.getElementById('file-input') as HTMLInputElement;
  const preview    = document.getElementById('file-preview')!;
  const previewName = document.getElementById('file-preview-name')!;
  const previewSize = document.getElementById('file-preview-size')!;
  const progressWrap = document.getElementById('upload-progress-wrap')!;
  const progressBar  = document.getElementById('upload-bar')!;
  const progressPct  = document.getElementById('upload-pct')!;
  const submitBtn    = document.getElementById('upload-submit') as HTMLButtonElement;

  function openModal() {
    selectedFile = null;
    (document.getElementById('upload-form') as HTMLFormElement).reset();
    preview.classList.add('hidden');
    dropZone.classList.remove('hidden');
    progressWrap.classList.add('hidden');
    submitBtn.disabled = false;
    modal.classList.remove('hidden');
  }

  function closeModal() { modal.classList.add('hidden'); }

  document.getElementById('upload-btn')!.addEventListener('click', openModal);
  document.getElementById('close-upload-modal')!.addEventListener('click', closeModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

  // Click drop zone → file input
  dropZone.addEventListener('click', () => fileInput.click());

  // Drag and drop
  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('border-scout-blue', 'bg-scout-blue-pale'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-scout-blue', 'bg-scout-blue-pale'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('border-scout-blue', 'bg-scout-blue-pale');
    const f = e.dataTransfer?.files[0];
    if (f) setFile(f);
  });

  fileInput.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if (f) setFile(f);
  });

  document.getElementById('clear-file')!.addEventListener('click', e => {
    e.stopPropagation();
    selectedFile = null;
    fileInput.value = '';
    preview.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  function setFile(f: File) {
    selectedFile = f;
    previewName.textContent = f.name;
    previewSize.textContent = formatBytes(f.size);
    dropZone.classList.add('hidden');
    preview.classList.remove('hidden');
  }

  // ── Upload submit ─────────────────────────────────────────────────────────

  (document.getElementById('upload-form') as HTMLFormElement).addEventListener('submit', async e => {
    e.preventDefault();
    if (!selectedFile) { alert('Please select a file.'); return; }

    const category = (document.getElementById('upload-category') as HTMLInputElement).value.trim();
    if (!category) { alert('Please enter a category.'); return; }

    submitBtn.disabled = true;
    progressWrap.classList.remove('hidden');
    progressBar.style.width = '0%';
    progressPct.textContent = '0%';
    setStatus('Uploading…', 'text-gray-400');

    const formData = new FormData();
    formData.append('file', selectedFile);
    formData.append('category', category);
    formData.append('sha', currentSha);

    // Use XHR for upload progress
    await new Promise<void>((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/api/documents/upload');
      xhr.upload.addEventListener('progress', ev => {
        if (ev.lengthComputable) {
          const pct = Math.round((ev.loaded / ev.total) * 100);
          progressBar.style.width = `${pct}%`;
          progressPct.textContent = `${pct}%`;
        }
      });
      xhr.addEventListener('load', () => {
        try {
          const data = JSON.parse(xhr.responseText) as { ok: boolean; document?: Document; sha?: string; error?: string };
          if (xhr.status >= 400) throw new Error(data.error ?? `HTTP ${xhr.status}`);
          if (data.document) documents.push(data.document);
          if (data.sha) currentSha = data.sha;
          progressBar.style.width = '100%';
          progressPct.textContent = '100%';
          setStatus('Uploaded', 'text-green-600');
          setTimeout(() => setStatus('', ''), 2000);
          renderDocuments();
          closeModal();
          resolve();
        } catch (err) {
          reject(err);
        }
      });
      xhr.addEventListener('error', () => reject(new Error('Network error')));
      xhr.send(formData);
    }).catch(err => {
      console.error('Upload error:', err);
      setStatus('Upload failed', 'text-red-500');
      submitBtn.disabled = false;
      progressWrap.classList.add('hidden');
    });
  });

  loadDocuments();
</script>
