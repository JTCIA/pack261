---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await doc.render();

function formatDate(date?: Date) {
  if (!date) return null;
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<AdminLayout title={doc.data.title} activeSection="docs">

  <div class="flex gap-8">
    <!-- Main content -->
    <div class="flex-1 min-w-0">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1 text-sm text-gray-400 mb-6">
        <a href="/admin/docs" class="hover:text-scout-blue transition-colors">Documentation</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-gray-500">{doc.data.section}</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-gray-700 font-medium">{doc.data.title}</span>
      </nav>

      <!-- Doc header -->
      <div class="mb-6 pb-6 border-b border-gray-200">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 mb-1">{doc.data.title}</h1>
            {doc.data.description && <p class="text-gray-500">{doc.data.description}</p>}
          </div>
          <a
            href={`/admin/docs/edit/${doc.slug}`}
            class="flex items-center gap-1.5 text-sm text-gray-500 hover:text-scout-blue border border-gray-200 px-3 py-1.5 rounded-lg hover:border-scout-blue transition-colors flex-shrink-0"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Edit Document
          </a>
        </div>
        {doc.data.lastUpdated && (
          <p class="text-xs text-gray-400 mt-3">Last updated: {formatDate(doc.data.lastUpdated)}</p>
        )}
      </div>

      <!-- Rendered content -->
      <div class="prose prose-gray max-w-none prose-headings:text-scout-blue prose-a:text-scout-blue-mid prose-code:text-scout-blue prose-code:bg-blue-50 prose-code:px-1 prose-code:rounded">
        <Content />
      </div>

      <!-- Back link -->
      <div class="mt-10 pt-6 border-t border-gray-200">
        <a href="/admin/docs" class="flex items-center gap-1 text-sm text-scout-blue-mid hover:text-scout-blue transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Documentation
        </a>
      </div>
    </div>

    <!-- Table of contents -->
    {headings.length > 1 && (
      <aside class="hidden xl:block w-52 flex-shrink-0">
        <div class="sticky top-24">
          <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">On this page</div>
          <nav class="space-y-1">
            {headings.map((h) => (
              <a
                href={`#${h.slug}`}
                class={`block text-xs py-1 transition-colors hover:text-scout-blue ${
                  h.depth === 2 ? 'text-gray-600 font-medium' : 'text-gray-400 pl-3'
                }`}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    )}
  </div>

</AdminLayout>
