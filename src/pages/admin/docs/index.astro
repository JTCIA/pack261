---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs');

// Group by section
const sections = allDocs.reduce((acc, doc) => {
  const section = doc.data.section;
  if (!acc[section]) acc[section] = [];
  acc[section].push(doc);
  return acc;
}, {} as Record<string, typeof allDocs>);

// Sort within each section
for (const section of Object.values(sections)) {
  section.sort((a, b) => a.data.order - b.data.order);
}

function formatDate(date?: Date) {
  if (!date) return null;
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<AdminLayout title="Documentation" activeSection="docs">

  <div id="flash-banner" class="hidden mb-5 px-4 py-3 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium items-center gap-2">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="flash-text"></span>
  </div>

  <div class="flex items-center justify-between mb-6">
    <div>
      <p class="text-sm text-gray-500 mt-1">Leader guides, policies, and reference documents</p>
    </div>
    <a href="/admin/docs/new"
      class="flex items-center gap-1.5 text-sm bg-scout-blue text-white px-3 py-1.5 rounded-lg hover:bg-scout-blue-mid transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      New Document
    </a>
  </div>

  <!-- Search -->
  <div class="relative mb-6">
    <svg class="absolute left-3 top-2.5 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      type="search"
      id="doc-search"
      placeholder="Search documentation..."
      class="w-full border border-gray-200 rounded-lg pl-9 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue bg-white"
    />
  </div>

  <!-- Doc sections -->
  <div id="docs-list" class="space-y-6">
    {Object.entries(sections).map(([section, docs]) => (
      <div class="doc-section">
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">{section}</h2>
        <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100 overflow-hidden">
          {docs.map((doc) => (
            <div
              data-title={doc.data.title.toLowerCase()}
              data-desc={(doc.data.description ?? '').toLowerCase()}
              class="doc-item flex items-start justify-between px-5 py-4"
            >
              <a href={`/admin/docs/${doc.slug}`} class="flex items-start gap-3 flex-1 min-w-0 group hover:text-scout-blue transition-colors">
                <svg class="w-5 h-5 text-gray-300 group-hover:text-scout-blue mt-0.5 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <div class="min-w-0">
                  <div class="text-sm font-medium text-gray-900 group-hover:text-scout-blue transition-colors">{doc.data.title}</div>
                  {doc.data.description && (
                    <div class="text-xs text-gray-500 mt-0.5">{doc.data.description}</div>
                  )}
                  {doc.data.lastUpdated && (
                    <div class="text-xs text-gray-400 mt-0.5">Updated {formatDate(doc.data.lastUpdated)}</div>
                  )}
                </div>
              </a>
              <a
                href={`/admin/docs/edit/${doc.slug}`}
                class="ml-4 flex-shrink-0 text-xs px-3 py-1.5 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition-colors"
              >
                Edit
              </a>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Empty state for search -->
  <div id="no-results" class="hidden text-center py-12 text-gray-400">
    <svg class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="text-sm">No documents match your search.</p>
  </div>

  <!-- Rebuild note -->
  <div class="mt-8 bg-blue-50 border border-blue-100 rounded-xl p-4">
    <p class="text-xs text-blue-700 leading-relaxed">
      <strong>Note:</strong> After creating or editing a document, the public site rebuilds automatically in about 2 minutes.
    </p>
  </div>

</AdminLayout>

<script>
  // Show success flash from redirect query param
  const params = new URLSearchParams(location.search);
  const saved = params.get('saved');
  if (saved) {
    const banner = document.getElementById('flash-banner');
    const text = document.getElementById('flash-text');
    if (banner && text) {
      text.textContent = saved === 'created'
        ? 'Document created! Site rebuilds in ~2 minutes.'
        : 'Document updated! Site rebuilds in ~2 minutes.';
      banner.classList.remove('hidden');
      banner.classList.add('flex');
    }
    // Clean URL
    history.replaceState({}, '', location.pathname);
  }

  const searchInput = document.getElementById('doc-search') as HTMLInputElement;
  const items = document.querySelectorAll<HTMLAnchorElement>('.doc-item');
  const sections = document.querySelectorAll<HTMLDivElement>('.doc-section');
  const noResults = document.getElementById('no-results');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;

    items.forEach(item => {
      const title = item.dataset.title ?? '';
      const desc = item.dataset.desc ?? '';
      const matches = !query || title.includes(query) || desc.includes(query);
      item.style.display = matches ? '' : 'none';
      if (matches) visible++;
    });

    // Hide empty sections
    sections.forEach(section => {
      const visibleItems = section.querySelectorAll('.doc-item:not([style*="none"])');
      section.style.display = visibleItems.length ? '' : 'none';
    });

    noResults?.classList.toggle('hidden', visible > 0);
  });
</script>
