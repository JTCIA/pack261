---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs');

// Group by section
const sections = allDocs.reduce((acc, doc) => {
  const section = doc.data.section;
  if (!acc[section]) acc[section] = [];
  acc[section].push(doc);
  return acc;
}, {} as Record<string, typeof allDocs>);

// Sort within each section
for (const section of Object.values(sections)) {
  section.sort((a, b) => a.data.order - b.data.order);
}

function formatDate(date?: Date) {
  if (!date) return null;
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<AdminLayout title="Documentation" activeSection="docs">

  <div class="flex items-center justify-between mb-6">
    <div>
      <p class="text-sm text-gray-500 mt-1">Leader guides, policies, and reference documents</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="https://github.com/JTCIA/pack261/tree/main/src/content/docs" target="_blank" rel="noopener"
        class="flex items-center gap-1.5 text-sm bg-gray-800 text-white px-3 py-1.5 rounded-lg hover:bg-gray-700 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        Edit on GitHub
      </a>
    </div>
  </div>

  <!-- Search -->
  <div class="relative mb-6">
    <svg class="absolute left-3 top-2.5 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      type="search"
      id="doc-search"
      placeholder="Search documentation..."
      class="w-full border border-gray-200 rounded-lg pl-9 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue bg-white"
    />
  </div>

  <!-- Doc sections -->
  <div id="docs-list" class="space-y-6">
    {Object.entries(sections).map(([section, docs]) => (
      <div class="doc-section">
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">{section}</h2>
        <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100 overflow-hidden">
          {docs.map((doc) => (
            <a
              href={`/admin/docs/${doc.slug}`}
              data-title={doc.data.title.toLowerCase()}
              data-desc={(doc.data.description ?? '').toLowerCase()}
              class="doc-item flex items-start justify-between px-5 py-4 hover:bg-scout-blue-pale transition-colors group"
            >
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-gray-300 group-hover:text-scout-blue mt-0.5 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <div>
                  <div class="text-sm font-medium text-gray-900 group-hover:text-scout-blue transition-colors">{doc.data.title}</div>
                  {doc.data.description && (
                    <div class="text-xs text-gray-500 mt-0.5">{doc.data.description}</div>
                  )}
                </div>
              </div>
              <div class="flex items-center gap-3 flex-shrink-0 ml-4">
                {doc.data.lastUpdated && (
                  <span class="text-xs text-gray-400">Updated {formatDate(doc.data.lastUpdated)}</span>
                )}
                <svg class="w-4 h-4 text-gray-400 group-hover:text-scout-blue transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Empty state for search -->
  <div id="no-results" class="hidden text-center py-12 text-gray-400">
    <svg class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="text-sm">No documents match your search.</p>
  </div>

  <!-- How to add docs note -->
  <div class="mt-8 bg-gray-50 border border-gray-200 rounded-xl p-4">
    <h3 class="text-sm font-semibold text-gray-700 mb-1 flex items-center gap-2">
      <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Adding Documentation
    </h3>
    <p class="text-xs text-gray-500 leading-relaxed">
      Documents are markdown files stored in <code class="bg-gray-200 px-1 rounded">src/content/docs/</code> in the GitHub repository.
      Create a new folder with an <code class="bg-gray-200 px-1 rounded">index.md</code> file to add a new document.
      The front matter controls the title, section, and display order.
    </p>
  </div>

</AdminLayout>

<script>
  const searchInput = document.getElementById('doc-search') as HTMLInputElement;
  const items = document.querySelectorAll<HTMLAnchorElement>('.doc-item');
  const sections = document.querySelectorAll<HTMLDivElement>('.doc-section');
  const noResults = document.getElementById('no-results');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;

    items.forEach(item => {
      const title = item.dataset.title ?? '';
      const desc = item.dataset.desc ?? '';
      const matches = !query || title.includes(query) || desc.includes(query);
      item.style.display = matches ? '' : 'none';
      if (matches) visible++;
    });

    // Hide empty sections
    sections.forEach(section => {
      const visibleItems = section.querySelectorAll('.doc-item:not([style*="none"])');
      section.style.display = visibleItems.length ? '' : 'none';
    });

    noResults?.classList.toggle('hidden', visible > 0);
  });
</script>
