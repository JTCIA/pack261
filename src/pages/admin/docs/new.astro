---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { putFile, buildDocMd, slugify } from '../../../lib/github.ts';

export const prerender = false;

const token = Astro.locals.runtime.env.GITHUB_TOKEN;

let error = '';
const today = new Date().toISOString().split('T')[0];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title       = (form.get('title')       as string ?? '').trim();
  const description = (form.get('description') as string ?? '').trim();
  const section     = (form.get('section')     as string ?? '').trim();
  const order       = parseInt(form.get('order') as string ?? '99', 10);
  const lastUpdated = (form.get('lastUpdated') as string ?? today);
  const body        = (form.get('body')        as string ?? '').trim();

  if (!title || !section || !body) {
    error = 'Title, section, and body are required.';
  } else {
    const dirSlug = slugify(title);
    const path = `src/content/docs/${dirSlug}/index.md`;
    const content = buildDocMd({ title, description, section, order, lastUpdated, body });
    const result = await putFile(path, content, `Add doc: ${title}`, undefined, token);
    if (result.ok) {
      return Astro.redirect('/admin/docs?saved=created');
    }
    error = `Could not save: ${result.error ?? 'GitHub API error'}. Check that GITHUB_TOKEN is set.`;
  }
}
---

<AdminLayout title="New Document" activeSection="docs">

  <nav class="flex items-center gap-1 text-sm text-gray-400 mb-6">
    <a href="/admin/docs" class="hover:text-scout-blue transition-colors">Documentation</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-gray-700 font-medium">New Document</span>
  </nav>

  {error && (
    <div class="mb-5 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm flex items-start gap-2">
      <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      {error}
    </div>
  )}

  <form method="post" class="space-y-5 max-w-2xl">

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1">Title <span class="text-red-400">*</span></label>
        <input type="text" name="title" required
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
          placeholder="e.g. Den Leader Guide" />
      </div>

      <div class="sm:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
        <input type="text" name="description"
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
          placeholder="Short description shown in the docs list" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Section <span class="text-red-400">*</span></label>
        <input type="text" name="section" required list="sections"
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
          placeholder="e.g. Leadership" />
        <datalist id="sections">
          <option value="Leadership" />
          <option value="Policies" />
          <option value="Planning" />
          <option value="Resources" />
        </datalist>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Display order</label>
        <input type="number" name="order" value="99" min="1" max="999"
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Last updated</label>
        <input type="date" name="lastUpdated" value={today}
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Content <span class="text-red-400">*</span></label>
      <p class="text-xs text-gray-500 mb-1.5">Supports markdown: **bold**, *italic*, ## Heading, - lists, [link](url), tables</p>
      <textarea name="body" required rows="18"
        class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-scout-blue resize-y"
        placeholder="Write your document content here..."></textarea>
    </div>

    <div class="flex items-center gap-3 pt-1">
      <button type="submit"
        class="bg-scout-blue text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-scout-blue-mid transition-colors">
        Create Document
      </button>
      <a href="/admin/docs" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">Cancel</a>
    </div>
  </form>

</AdminLayout>
