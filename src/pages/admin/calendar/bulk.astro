---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Bulk Import Events" activeSection="calendar">

  <nav class="flex items-center gap-1 text-sm text-gray-400 mb-6">
    <a href="/admin/calendar" class="hover:text-scout-blue transition-colors">Calendar</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-gray-700 font-medium">Bulk Import</span>
  </nav>

  <p class="text-sm text-gray-500 mb-6">
    Fill in each event and click <strong>Add to Queue</strong>. When you're done, click <strong>Import All</strong> — every event saves in a single commit, triggering only one deployment.
  </p>

  <div class="grid lg:grid-cols-2 gap-8 items-start">

    <!-- ── Left: event form ───────────────────────────────────────────────── -->
    <div class="bg-white border border-gray-200 rounded-xl p-5">
      <h2 class="font-semibold text-gray-900 mb-4">Event Details</h2>

      <form id="event-form" class="space-y-4" novalidate>
        <div class="grid sm:grid-cols-2 gap-4">

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Date <span class="text-red-400">*</span></label>
            <input type="date" id="f-date" required
              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Type <span class="text-red-400">*</span></label>
            <select id="f-type"
              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue">
              <option value="meeting">Meeting</option>
              <option value="camping">Camping</option>
              <option value="event">Event</option>
              <option value="deadline">Deadline</option>
              <option value="special">Special</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Den</label>
            <select id="f-den"
              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue">
              <option value="">All Dens (Pack-wide)</option>
              <option value="lion">Lion</option>
              <option value="tiger">Tiger</option>
              <option value="wolf">Wolf</option>
              <option value="bear">Bear</option>
              <option value="webelos">Webelos</option>
              <option value="aol">Arrow of Light (AoL)</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Title <span class="text-red-400">*</span></label>
            <input type="text" id="f-title" required
              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
              placeholder="e.g. Pinewood Derby" />
          </div>

          <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
            <input type="text" id="f-location"
              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
              placeholder="e.g. Community Center" />
          </div>

          <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
            <textarea id="f-desc" rows="2"
              class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue resize-none"
              placeholder="Brief details..."></textarea>
          </div>
        </div>

        <div id="form-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2"></div>

        <button type="submit"
          class="w-full bg-scout-blue text-white py-2 rounded-lg text-sm font-semibold hover:bg-scout-blue-mid transition-colors flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add to Queue
        </button>
      </form>
    </div>

    <!-- ── Right: queue ───────────────────────────────────────────────────── -->
    <div class="flex flex-col gap-4">

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
          <h2 class="font-semibold text-gray-900">
            Queue
            <span id="queue-count" class="ml-1.5 text-xs font-bold bg-scout-blue text-white rounded-full px-2 py-0.5">0</span>
          </h2>
          <button id="clear-queue-btn"
            class="hidden text-xs text-red-500 hover:text-red-700 transition-colors">
            Clear all
          </button>
        </div>

        <div id="queue-empty" class="px-4 py-8 text-center text-sm text-gray-400">
          No events queued yet. Fill in the form and click Add to Queue.
        </div>

        <ul id="queue-list" class="divide-y divide-gray-50"></ul>
      </div>

      <!-- Import button -->
      <div id="import-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-3"></div>

      <button id="import-btn" disabled
        class="w-full py-3 rounded-xl text-sm font-semibold transition-colors
               bg-gray-100 text-gray-400 cursor-not-allowed">
        Import All Events
      </button>

      <p class="text-xs text-gray-400 text-center">All queued events will be saved in a single GitHub commit.</p>
    </div>

  </div>

</AdminLayout>

<script>
  interface QueuedEvent {
    date: string; type: string; den: string;
    title: string; location: string; description: string;
  }

  const typeColors: Record<string, string> = {
    meeting: 'bg-blue-100 text-blue-800', camping: 'bg-green-100 text-green-800',
    deadline: 'bg-red-100 text-red-800',  event: 'bg-yellow-100 text-yellow-800',
    special: 'bg-purple-100 text-purple-800',
  };
  const denColors: Record<string, string> = {
    lion: 'bg-yellow-100 text-yellow-800', tiger: 'bg-orange-100 text-orange-800',
    wolf: 'bg-red-100 text-red-800',        bear: 'bg-amber-100 text-amber-800',
    webelos: 'bg-blue-100 text-blue-800',   aol: 'bg-indigo-100 text-indigo-800',
  };
  const denLabels: Record<string, string> = {
    lion: 'Lion', tiger: 'Tiger', wolf: 'Wolf',
    bear: 'Bear', webelos: 'Webelos', aol: 'AoL',
  };

  let queue: QueuedEvent[] = [];

  // ── Form fields ────────────────────────────────────────────────────────────
  const fDate     = document.getElementById('f-date')     as HTMLInputElement;
  const fType     = document.getElementById('f-type')     as HTMLSelectElement;
  const fDen      = document.getElementById('f-den')      as HTMLSelectElement;
  const fTitle    = document.getElementById('f-title')    as HTMLInputElement;
  const fLocation = document.getElementById('f-location') as HTMLInputElement;
  const fDesc     = document.getElementById('f-desc')     as HTMLTextAreaElement;
  const formError = document.getElementById('form-error')!;

  // Set date default to today
  fDate.value = new Date().toISOString().split('T')[0];

  function esc(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function fmtDate(ds: string) {
    return new Date(ds + 'T12:00:00').toLocaleDateString('en-US',
      { month: 'short', day: 'numeric', year: 'numeric' });
  }

  // ── Queue rendering ────────────────────────────────────────────────────────
  function renderQueue() {
    const countEl   = document.getElementById('queue-count')!;
    const emptyEl   = document.getElementById('queue-empty')!;
    const listEl    = document.getElementById('queue-list')!;
    const clearBtn  = document.getElementById('clear-queue-btn')!;
    const importBtn = document.getElementById('import-btn') as HTMLButtonElement;

    countEl.textContent = String(queue.length);
    emptyEl.style.display = queue.length ? 'none' : '';
    clearBtn.classList.toggle('hidden', queue.length === 0);

    // Update import button
    importBtn.disabled = queue.length === 0;
    if (queue.length === 0) {
      importBtn.className = 'w-full py-3 rounded-xl text-sm font-semibold transition-colors bg-gray-100 text-gray-400 cursor-not-allowed';
      importBtn.textContent = 'Import All Events';
    } else {
      importBtn.className = 'w-full py-3 rounded-xl text-sm font-semibold transition-colors bg-green-600 text-white hover:bg-green-700';
      importBtn.textContent = `Import ${queue.length} Event${queue.length !== 1 ? 's' : ''} →`;
    }

    listEl.innerHTML = queue.map((ev, idx) => `
      <li class="flex items-start gap-3 px-4 py-3">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap mb-0.5">
            <span class="text-sm font-medium text-gray-900">${esc(ev.title)}</span>
            <span class="text-xs px-1.5 py-0.5 rounded-full capitalize font-medium ${typeColors[ev.type] ?? typeColors.event}">${esc(ev.type)}</span>
            ${ev.den ? `<span class="text-xs px-1.5 py-0.5 rounded-full font-medium ${denColors[ev.den] ?? ''}">${esc(denLabels[ev.den] ?? ev.den)}</span>` : ''}
          </div>
          <div class="text-xs text-gray-400">${fmtDate(ev.date)}${ev.location ? ' · ' + esc(ev.location) : ''}</div>
          ${ev.description ? `<div class="text-xs text-gray-400 truncate">${esc(ev.description)}</div>` : ''}
        </div>
        <button data-idx="${idx}" class="remove-btn flex-shrink-0 text-gray-300 hover:text-red-500 transition-colors p-0.5 mt-0.5" title="Remove">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </li>`).join('');

    listEl.querySelectorAll<HTMLButtonElement>('.remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        queue.splice(Number(btn.dataset.idx), 1);
        renderQueue();
      });
    });
  }

  // ── Add to queue ───────────────────────────────────────────────────────────
  document.getElementById('event-form')!.addEventListener('submit', e => {
    e.preventDefault();
    formError.classList.add('hidden');

    const date  = fDate.value.trim();
    const title = fTitle.value.trim();
    if (!date || !title) {
      formError.textContent = 'Date and title are required.';
      formError.classList.remove('hidden');
      return;
    }

    queue.push({
      date,
      type:        fType.value,
      den:         fDen.value,
      title,
      location:    fLocation.value.trim(),
      description: fDesc.value.trim(),
    });

    // Reset form (keep date and type for convenience)
    fTitle.value    = '';
    fLocation.value = '';
    fDesc.value     = '';
    fDen.value      = '';
    fTitle.focus();

    renderQueue();
  });

  // ── Clear queue ────────────────────────────────────────────────────────────
  document.getElementById('clear-queue-btn')!.addEventListener('click', () => {
    if (confirm(`Remove all ${queue.length} queued event${queue.length !== 1 ? 's' : ''}?`)) {
      queue = [];
      renderQueue();
    }
  });

  // ── Import all ─────────────────────────────────────────────────────────────
  document.getElementById('import-btn')!.addEventListener('click', async () => {
    if (queue.length === 0) return;

    const importBtn = document.getElementById('import-btn') as HTMLButtonElement;
    const errEl     = document.getElementById('import-error')!;
    errEl.classList.add('hidden');
    importBtn.disabled = true;
    importBtn.textContent = 'Saving…';
    importBtn.className = 'w-full py-3 rounded-xl text-sm font-semibold bg-gray-100 text-gray-400 cursor-not-allowed';

    try {
      const res  = await fetch('/api/calendar-bulk', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ events: queue }),
      });
      const data = await res.json() as { ok?: boolean; count?: number; error?: string };

      if (!res.ok) throw new Error(data.error ?? `HTTP ${res.status}`);

      // Success — redirect to calendar list
      window.location.href = `/admin/calendar?saved=bulk&count=${data.count ?? queue.length}`;
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Unknown error';
      errEl.textContent = `Import failed: ${msg}`;
      errEl.classList.remove('hidden');
      // Re-enable button
      importBtn.disabled = false;
      importBtn.className = 'w-full py-3 rounded-xl text-sm font-semibold transition-colors bg-green-600 text-white hover:bg-green-700';
      importBtn.textContent = `Import ${queue.length} Event${queue.length !== 1 ? 's' : ''} →`;
    }
  });

  renderQueue();
</script>
