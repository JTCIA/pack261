---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCalendar, putCalendar } from '../../../lib/github.ts';
import type { CalendarEvent } from '../../../lib/github.ts';

export const prerender = false;

let error = '';
let saved = '';

// Handle DELETE action
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string;
  const id = (form.get('id') as string ?? '').trim();

  if (action === 'delete' && id) {
    const cal = await getCalendar();
    if (!cal) {
      error = 'Could not load calendar. Check that GITHUB_TOKEN is set.';
    } else {
      const updated = cal.events.filter((e) => e.id !== id);
      const result = await putCalendar(updated, cal.sha, `Remove calendar event: ${id}`);
      if (result.ok) {
        return Astro.redirect('/admin/calendar?saved=deleted');
      }
      error = `Could not delete: ${result.error ?? 'GitHub API error'}`;
    }
  }
}

const savedParam = Astro.url.searchParams.get('saved');
if (savedParam === 'created') saved = 'Event added to the calendar.';
if (savedParam === 'updated') saved = 'Event updated successfully.';
if (savedParam === 'deleted') saved = 'Event removed from the calendar.';

const cal = await getCalendar();
const events: CalendarEvent[] = cal ? cal.events.sort((a, b) => a.date.localeCompare(b.date)) : [];

const typeColors: Record<string, string> = {
  meeting: 'bg-blue-100 text-blue-800',
  camping: 'bg-green-100 text-green-800',
  deadline: 'bg-red-100 text-red-800',
  event: 'bg-yellow-100 text-yellow-800',
  special: 'bg-purple-100 text-purple-800',
};

function formatDate(dateStr: string) {
  return new Date(dateStr + 'T12:00:00').toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric',
  });
}

// Group by month for display
const grouped = events.reduce((acc, event) => {
  const d = new Date(event.date + 'T12:00:00');
  const key = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  if (!acc[key]) acc[key] = [];
  acc[key].push(event);
  return acc;
}, {} as Record<string, CalendarEvent[]>);
---

<AdminLayout title="Calendar" activeSection="calendar">

  <div class="flex items-center justify-between mb-6">
    <p class="text-sm text-gray-500">Manage upcoming pack events and meetings</p>
    <a href="/admin/calendar/new"
      class="inline-flex items-center gap-2 bg-scout-blue text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-scout-blue-mid transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Add Event
    </a>
  </div>

  {saved && (
    <div class="mb-5 px-4 py-3 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm flex items-center gap-2">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      {saved}
    </div>
  )}

  {error && (
    <div class="mb-5 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm flex items-start gap-2">
      <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      {error}
    </div>
  )}

  {!cal && !error && (
    <div class="mb-5 px-4 py-3 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg text-sm">
      Could not load calendar data. Make sure <code class="font-mono bg-yellow-100 px-1 rounded">GITHUB_TOKEN</code> is set in your environment.
    </div>
  )}

  {events.length === 0 && cal && (
    <div class="text-center py-16 text-gray-400">
      <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <p class="text-sm mb-4">No events yet.</p>
      <a href="/admin/calendar/new" class="text-scout-blue hover:underline text-sm font-medium">Add the first event →</a>
    </div>
  )}

  <div class="space-y-8">
    {Object.entries(grouped).map(([month, monthEvents]) => (
      <div>
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 flex items-center gap-2">
          <div class="h-px flex-1 bg-gray-200"></div>
          <span class="px-2">{month}</span>
          <div class="h-px flex-1 bg-gray-200"></div>
        </h2>

        <div class="space-y-2">
          {monthEvents.map((event) => (
            <div class="flex items-center gap-3 bg-white border border-gray-200 rounded-xl p-3 hover:border-gray-300 transition-colors">
              <!-- Date badge -->
              <div class="flex-shrink-0 text-center w-10">
                <div class="text-2xl font-bold text-scout-blue leading-none">
                  {new Date(event.date + 'T12:00:00').getDate()}
                </div>
                <div class="text-xs text-gray-400 uppercase">
                  {new Date(event.date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short' })}
                </div>
              </div>

              <div class="border-l border-gray-200 pl-3 flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-sm font-medium text-gray-900">{event.title}</span>
                  <span class={`text-xs px-2 py-0.5 rounded-full capitalize font-medium ${typeColors[event.type] ?? typeColors.event}`}>
                    {event.type}
                  </span>
                </div>
                {event.location && (
                  <p class="text-xs text-gray-400 mt-0.5">{event.location}</p>
                )}
                {event.description && (
                  <p class="text-xs text-gray-500 mt-0.5 truncate">{event.description}</p>
                )}
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-1 flex-shrink-0">
                <a href={`/admin/calendar/edit/${event.id}`}
                  class="p-1.5 text-gray-400 hover:text-scout-blue hover:bg-scout-blue-pale rounded transition-colors"
                  title="Edit event">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                </a>
                <form method="post" onsubmit="return confirm('Remove this event from the calendar?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={event.id} />
                  <button type="submit"
                    class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors"
                    title="Delete event">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-8 pt-6 border-t border-gray-100 text-xs text-gray-400">
    {events.length} event{events.length !== 1 ? 's' : ''} total &middot;
    <a href="/calendar" target="_blank" class="hover:text-scout-blue transition-colors">View public calendar →</a>
  </div>

</AdminLayout>
