---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { deleteFile, getFile } from '../../../lib/github.ts';

let flash = '';
let flashType: 'success' | 'error' = 'success';

// Flash from redirect after create/edit
const saved = Astro.url.searchParams.get('saved');
if (saved === 'created') { flash = 'Announcement published! Site rebuilds in ~2 minutes.'; flashType = 'success'; }
if (saved === 'updated') { flash = 'Announcement updated! Site rebuilds in ~2 minutes.'; flashType = 'success'; }

// Handle delete
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    const slug = form.get('slug') as string;
    const path = `src/content/announcements/${slug}.md`;
    const file = await getFile(path);
    if (file) {
      const result = await deleteFile(path, file.sha, `Delete announcement: ${slug}`);
      if (result.ok) {
        flash = 'Announcement deleted. Site rebuilds in ~2 minutes.';
        flashType = 'success';
      } else {
        flash = `Delete failed: ${result.error}`;
        flashType = 'error';
      }
    } else {
      flash = 'File not found on GitHub.';
      flashType = 'error';
    }
  }
}

const announcements = (await getCollection('announcements'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const categoryColors: Record<string, string> = {
  event: 'bg-blue-100 text-blue-700',
  news: 'bg-green-100 text-green-700',
  fundraiser: 'bg-yellow-100 text-yellow-700',
  achievement: 'bg-purple-100 text-purple-700',
  reminder: 'bg-orange-100 text-orange-700',
};

export const prerender = false;
---

<AdminLayout title="Announcements" activeSection="announcements">

  <div class="flex items-center justify-between mb-6">
    <p class="text-sm text-gray-500">Create and manage public announcements</p>
    <a href="/admin/announcements/new"
      class="flex items-center gap-1.5 text-sm bg-scout-blue text-white px-3 py-1.5 rounded-lg hover:bg-scout-blue-mid transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      New Announcement
    </a>
  </div>

  {flash && (
    <div class={`mb-5 px-4 py-3 rounded-lg text-sm font-medium flex items-center gap-2 ${
      flashType === 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800'
    }`}>
      {flashType === 'success' ? (
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      ) : (
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      )}
      {flash}
    </div>
  )}

  {/* Note about rebuild delay */}
  <div class="mb-5 px-4 py-3 bg-blue-50 border border-blue-100 rounded-lg text-xs text-blue-700">
    <strong>Note:</strong> After saving changes, the public site rebuilds automatically in about 2 minutes.
  </div>

  {announcements.length === 0 ? (
    <div class="text-center py-16 text-gray-400">
      <svg class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <p class="text-sm">No announcements yet. Create your first one!</p>
    </div>
  ) : (
    <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100 overflow-hidden">
      {announcements.map((post) => (
        <div class="flex items-start gap-4 px-5 py-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
              {post.data.pinned && (
                <svg class="w-3 h-3 text-scout-gold flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/>
                </svg>
              )}
              <p class="text-sm font-semibold text-gray-900 truncate">{post.data.title}</p>
            </div>
            <p class="text-xs text-gray-500 truncate">{post.data.summary}</p>
            <div class="flex items-center gap-2 mt-1.5">
              <span class={`text-xs px-2 py-0.5 rounded-full capitalize font-medium ${categoryColors[post.data.category] ?? 'bg-gray-100 text-gray-600'}`}>
                {post.data.category}
              </span>
              <span class="text-xs text-gray-400">{formatDate(post.data.date)}</span>
              <span class="text-xs text-gray-400">by {post.data.author}</span>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <a
              href={`/admin/announcements/edit/${post.slug}`}
              class="text-xs px-3 py-1.5 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition-colors"
            >
              Edit
            </a>
            <form method="post" onsubmit="return confirm('Delete this announcement?')">
              <input type="hidden" name="_action" value="delete" />
              <input type="hidden" name="slug" value={post.slug} />
              <button type="submit"
                class="text-xs px-3 py-1.5 border border-red-200 rounded-lg text-red-600 hover:bg-red-50 transition-colors">
                Delete
              </button>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}

</AdminLayout>
