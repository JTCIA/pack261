---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import RichTextEditor from '../../../components/RichTextEditor.astro';
import { putFile, buildAnnouncementMd, slugify } from '../../../lib/github.ts';

export const prerender = false;

const token = Astro.locals.runtime.env.GITHUB_TOKEN;

let error = '';
const today = new Date().toISOString().split('T')[0];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title   = (form.get('title')   as string ?? '').trim();
  const date    = (form.get('date')    as string ?? today);
  const category= (form.get('category')as string ?? 'news');
  const pinned  = form.get('pinned') === 'on';
  const summary = (form.get('summary') as string ?? '').trim();
  const author  = (form.get('author')  as string ?? 'Pack 261 Leadership').trim();
  const body    = (form.get('body')    as string ?? '').trim();

  if (!title || !summary || !body) {
    error = 'Title, summary, and body are required.';
  } else {
    const slug = slugify(title);
    const path = `src/content/announcements/${slug}.md`;
    const content = buildAnnouncementMd({ title, date, category, pinned, summary, author, body });
    const result = await putFile(path, content, `Add announcement: ${title}`, undefined, token);
    if (result.ok) {
      return Astro.redirect('/admin/announcements?saved=created');
    }
    error = `Could not save: ${result.error ?? 'GitHub API error'}. Check that GITHUB_TOKEN is set.`;
  }
}
---

<AdminLayout title="New Announcement" activeSection="announcements">

  <nav class="flex items-center gap-1 text-sm text-gray-400 mb-6">
    <a href="/admin/announcements" class="hover:text-scout-blue transition-colors">Announcements</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-gray-700 font-medium">New</span>
  </nav>

  {error && (
    <div class="mb-5 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm flex items-start gap-2">
      <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      {error}
    </div>
  )}

  <form method="post" class="space-y-5 max-w-2xl">

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1">Title <span class="text-red-400">*</span></label>
        <input type="text" name="title" required
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
          placeholder="e.g. Pinewood Derby This Saturday!" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Date <span class="text-red-400">*</span></label>
        <input type="date" name="date" required value={today}
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Category <span class="text-red-400">*</span></label>
        <select name="category"
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue">
          <option value="news">News</option>
          <option value="event">Event</option>
          <option value="fundraiser">Fundraiser</option>
          <option value="achievement">Achievement</option>
          <option value="reminder">Reminder</option>
        </select>
      </div>

      <div class="sm:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1">Summary <span class="text-red-400">*</span></label>
        <input type="text" name="summary" required maxlength="200"
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue"
          placeholder="Short one-line summary shown in the announcement list" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Author</label>
        <input type="text" name="author" value="Pack 261 Leadership"
          class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue" />
      </div>

      <div class="flex items-end pb-2">
        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" name="pinned" class="w-4 h-4 rounded border-gray-300 text-scout-blue focus:ring-scout-blue" />
          Pin to top of announcements list
        </label>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1.5">Body <span class="text-red-400">*</span></label>
      <RichTextEditor name="body" required rows={14} placeholder="Write your announcement here..." />
    </div>

    <div class="flex items-center gap-3 pt-1">
      <button type="submit"
        class="bg-scout-blue text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-scout-blue-mid transition-colors">
        Publish Announcement
      </button>
      <a href="/admin/announcements" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">Cancel</a>
    </div>
  </form>

</AdminLayout>
