---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { getPlanner, isGHError } from '../../lib/github.ts';

const allAnnouncements = await getCollection('announcements');
const announcements = allAnnouncements
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const docs = await getCollection('docs');

const token = Astro.locals.runtime.env.GITHUB_TOKEN;
const plannerData = await getPlanner(token);
const activeProjectCount = (!plannerData || isGHError(plannerData))
  ? null
  : plannerData.tasks.filter(t => t.col !== 'done').length;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<AdminLayout title="Dashboard" activeSection="dashboard">

  <!-- Welcome banner -->
  <div class="bg-gradient-to-r from-scout-blue to-scout-blue-mid rounded-xl p-6 text-white mb-6">
    <h2 class="text-xl font-bold mb-1">Welcome to the Leader Portal</h2>
    <p class="text-blue-200 text-sm">Pack 261 leadership tools and resources — all in one place.</p>
  </div>

  <!-- Quick stats (3 cards) -->
  <div class="grid grid-cols-3 gap-4 mb-8">
    {[
      { label: 'Announcements',   value: String(allAnnouncements.length),                                           color: 'bg-blue-50 border-blue-200 text-scout-blue'    },
      { label: 'Docs Pages',      value: String(docs.length),                                                       color: 'bg-green-50 border-green-200 text-green-700'   },
      { label: 'Active Projects', value: activeProjectCount !== null ? String(activeProjectCount) : '—',            color: 'bg-yellow-50 border-yellow-200 text-yellow-700' },
    ].map(({ label, value, color }) => (
      <div class={`border rounded-xl p-4 ${color}`}>
        <div class="text-2xl font-bold">{value}</div>
        <div class="text-sm font-medium opacity-75">{label}</div>
      </div>
    ))}
  </div>

  <!-- Two-column layout -->
  <div class="grid md:grid-cols-2 gap-6">

    <!-- Recent announcements -->
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
        <h3 class="font-semibold text-gray-900">Recent Announcements</h3>
        <a href="/announcements" class="text-xs text-scout-blue-mid hover:text-scout-blue">View public &rarr;</a>
      </div>
      <div class="divide-y divide-gray-50">
        {announcements.map((post) => (
          <div class="px-4 py-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="text-sm font-medium text-gray-900">{post.data.title}</p>
                <p class="text-xs text-gray-500 mt-0.5">{formatDate(post.data.date)}</p>
              </div>
              <span class="text-xs capitalize bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full flex-shrink-0">{post.data.category}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Quick links -->
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100">
        <h3 class="font-semibold text-gray-900">Quick Actions</h3>
      </div>
      <div class="p-4 grid grid-cols-2 gap-3">
        {[
          { label: 'Documentation', href: '/admin/docs',                    icon: 'book',     desc: 'Leader guides & policies' },
          { label: 'Planner',       href: '/admin/planner',                 icon: 'clipboard', desc: 'Pack project tracking' },
          { label: 'Resources',     href: '/admin/resources',               icon: 'folder',   desc: 'Forms, links & tools' },
          { label: 'Scoutbook',     href: 'https://scoutbook.scouting.org', icon: 'external', desc: 'Advancement tracking' },
          { label: 'my.Scouting',   href: 'https://my.scouting.org',        icon: 'external', desc: 'Training & registration' },
          { label: 'Public Site',   href: '/',                              icon: 'globe',    desc: 'View parent-facing site' },
        ].map(({ label, href, icon, desc }) => (
          <a href={href} target={icon === 'external' ? '_blank' : undefined} rel={icon === 'external' ? 'noopener' : undefined}
            class="flex flex-col gap-1 p-3 border border-gray-200 rounded-lg hover:bg-scout-blue-pale hover:border-scout-blue transition-colors group">
            <span class="text-sm font-medium text-gray-800 group-hover:text-scout-blue flex items-center gap-1">
              {label}
              {icon === 'external' && (
                <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              )}
            </span>
            <span class="text-xs text-gray-400">{desc}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Leader Reminders -->
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden md:col-span-2">
      <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
        <h3 class="font-semibold text-gray-900">Leader Reminders</h3>
        <div class="flex items-center gap-3">
          <span id="reminder-status" class="text-xs text-gray-400"></span>
          <button id="add-reminder-btn" class="flex items-center gap-1 text-xs bg-scout-blue text-white px-2.5 py-1.5 rounded-lg hover:bg-scout-blue-mid transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add
          </button>
        </div>
      </div>
      <div class="p-4">
        <ul id="reminders-list" class="space-y-3">
          <li class="text-xs text-gray-400 py-2">Loading reminders…</li>
        </ul>
      </div>
    </div>

  </div>

  <!-- Reminder modal -->
  <div id="reminder-modal" class="hidden fixed inset-0 bg-black bg-opacity-40 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <h3 class="font-semibold text-gray-900" id="reminder-modal-title">Add Reminder</h3>
        <button id="close-reminder-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form id="reminder-form" class="p-5 space-y-4">
        <input type="hidden" id="reminder-id" />
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
          <select id="reminder-type" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue">
            <option value="info">Info (blue)</option>
            <option value="warning">Warning (yellow)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Text <span class="text-red-400">*</span></label>
          <textarea id="reminder-text" rows="3" required
            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-scout-blue resize-none"
            placeholder="Reminder text…"></textarea>
        </div>
        <div class="flex gap-2 pt-1">
          <button type="submit" class="flex-1 bg-scout-blue text-white py-2 rounded-lg text-sm font-semibold hover:bg-scout-blue-mid transition-colors">Save</button>
          <button type="button" id="delete-reminder-btn" class="hidden px-4 py-2 rounded-lg text-sm font-medium text-red-600 border border-red-200 hover:bg-red-50 transition-colors">Delete</button>
        </div>
      </form>
    </div>
  </div>

</AdminLayout>

<script>
  interface Reminder { id: string; type: 'warning' | 'info'; text: string; }

  let reminders: Reminder[] = [];
  let currentSha = '';
  let editingId: string | null = null;
  let saveTimer: ReturnType<typeof setTimeout> | null = null;

  const statusEl = document.getElementById('reminder-status')!;
  function setStatus(text: string, color: string) {
    statusEl.textContent = text;
    statusEl.className = `text-xs ${color}`;
  }

  function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2); }

  async function loadReminders() {
    setStatus('Loading…', 'text-gray-400');
    try {
      const res = await fetch('/api/reminders');
      const data = await res.json() as { reminders: Reminder[]; sha: string; error?: string };
      if (!res.ok) throw new Error(data.error ?? `HTTP ${res.status}`);
      reminders = data.reminders;
      currentSha = data.sha;
      setStatus('', '');
    } catch (err) {
      setStatus('Failed to load', 'text-red-500');
      console.error('Reminders load error:', err);
    }
    renderReminders();
  }

  async function saveReminders() {
    setStatus('Saving…', 'text-gray-400');
    try {
      const res = await fetch('/api/reminders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reminders, sha: currentSha }),
      });
      const data = await res.json() as { ok: boolean; sha?: string; error?: string };
      if (!res.ok) throw new Error(data.error ?? `HTTP ${res.status}`);
      if (data.sha) currentSha = data.sha;
      setStatus('Saved', 'text-green-600');
      setTimeout(() => setStatus('', ''), 2000);
    } catch (err) {
      setStatus('Save failed', 'text-red-500');
      console.error('Reminders save error:', err);
    }
  }

  function save() {
    if (saveTimer) clearTimeout(saveTimer);
    saveTimer = setTimeout(saveReminders, 300);
  }

  function esc(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderReminders() {
    const list = document.getElementById('reminders-list')!;
    if (reminders.length === 0) {
      list.innerHTML = '<li class="text-xs text-gray-400 py-2">No reminders yet. Click Add to create one.</li>';
      return;
    }
    list.innerHTML = reminders.map(r => `
      <li class="flex items-start gap-3 text-sm rounded-lg p-3 group ${r.type === 'warning' ? 'bg-yellow-50 border border-yellow-200' : 'bg-blue-50 border border-blue-100'}">
        ${r.type === 'warning'
          ? `<svg class="w-4 h-4 text-yellow-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`
          : `<svg class="w-4 h-4 text-blue-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`}
        <span class="flex-1 ${r.type === 'warning' ? 'text-yellow-800' : 'text-blue-800'}">${esc(r.text)}</span>
        <button data-id="${r.id}" class="edit-reminder-btn opacity-0 group-hover:opacity-100 flex-shrink-0 text-gray-400 hover:text-gray-700 transition-opacity p-0.5 rounded" title="Edit">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
        </button>
      </li>
    `).join('');

    list.querySelectorAll<HTMLButtonElement>('.edit-reminder-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const r = reminders.find(x => x.id === btn.dataset.id);
        if (r) openEdit(r);
      });
    });
  }

  // Modal
  const modal    = document.getElementById('reminder-modal')!;
  const form     = document.getElementById('reminder-form') as HTMLFormElement;
  const mTitle   = document.getElementById('reminder-modal-title')!;
  const delBtn   = document.getElementById('delete-reminder-btn')!;

  function openAdd() {
    editingId = null;
    mTitle.textContent = 'Add Reminder';
    form.reset();
    delBtn.classList.add('hidden');
    modal.classList.remove('hidden');
    (document.getElementById('reminder-text') as HTMLTextAreaElement).focus();
  }

  function openEdit(r: Reminder) {
    editingId = r.id;
    mTitle.textContent = 'Edit Reminder';
    (document.getElementById('reminder-type') as HTMLSelectElement).value = r.type;
    (document.getElementById('reminder-text') as HTMLTextAreaElement).value = r.text;
    delBtn.classList.remove('hidden');
    modal.classList.remove('hidden');
  }

  function closeModal() { modal.classList.add('hidden'); form.reset(); editingId = null; }

  document.getElementById('add-reminder-btn')!.addEventListener('click', openAdd);
  document.getElementById('close-reminder-modal')!.addEventListener('click', closeModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

  form.addEventListener('submit', e => {
    e.preventDefault();
    const r: Reminder = {
      id: editingId ?? uid(),
      type: (document.getElementById('reminder-type') as HTMLSelectElement).value as 'warning' | 'info',
      text: (document.getElementById('reminder-text') as HTMLTextAreaElement).value.trim(),
    };
    if (editingId) {
      reminders = reminders.map(x => x.id === editingId ? r : x);
    } else {
      reminders.push(r);
    }
    save();
    renderReminders();
    closeModal();
  });

  delBtn.addEventListener('click', () => {
    if (editingId && confirm('Delete this reminder?')) {
      reminders = reminders.filter(x => x.id !== editingId);
      save();
      renderReminders();
      closeModal();
    }
  });

  loadReminders();
</script>
