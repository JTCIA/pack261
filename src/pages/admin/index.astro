---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const announcements = (await getCollection('announcements'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const docs = await getCollection('docs');

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<AdminLayout title="Dashboard" activeSection="dashboard">

  <!-- Welcome banner -->
  <div class="bg-gradient-to-r from-scout-blue to-scout-blue-mid rounded-xl p-6 text-white mb-6">
    <h2 class="text-xl font-bold mb-1">Welcome to the Leader Portal</h2>
    <p class="text-blue-200 text-sm">Pack 261 leadership tools and resources — all in one place.</p>
  </div>

  <!-- Quick stats -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    {[
      { label: 'Announcements', value: '3', icon: 'bell', color: 'bg-blue-50 border-blue-200 text-scout-blue' },
      { label: 'Docs Pages', value: String(docs.length), icon: 'book', color: 'bg-green-50 border-green-200 text-green-700' },
      { label: 'Active Projects', value: '—', icon: 'clipboard', color: 'bg-yellow-50 border-yellow-200 text-yellow-700' },
      { label: 'Resources', value: '5', icon: 'folder', color: 'bg-purple-50 border-purple-200 text-purple-700' },
    ].map(({ label, value, icon, color }) => (
      <div class={`border rounded-xl p-4 ${color}`}>
        <div class="text-2xl font-bold">{value}</div>
        <div class="text-sm font-medium opacity-75">{label}</div>
      </div>
    ))}
  </div>

  <!-- Two-column layout -->
  <div class="grid md:grid-cols-2 gap-6">

    <!-- Recent announcements -->
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
        <h3 class="font-semibold text-gray-900">Recent Announcements</h3>
        <a href="/announcements" class="text-xs text-scout-blue-mid hover:text-scout-blue">View public &rarr;</a>
      </div>
      <div class="divide-y divide-gray-50">
        {announcements.map((post) => (
          <div class="px-4 py-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="text-sm font-medium text-gray-900">{post.data.title}</p>
                <p class="text-xs text-gray-500 mt-0.5">{formatDate(post.data.date)}</p>
              </div>
              <span class="text-xs capitalize bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full flex-shrink-0">{post.data.category}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Quick links -->
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100">
        <h3 class="font-semibold text-gray-900">Quick Actions</h3>
      </div>
      <div class="p-4 grid grid-cols-2 gap-3">
        {[
          { label: 'Documentation', href: '/admin/docs', icon: 'book', desc: 'Leader guides & policies' },
          { label: 'Planner', href: '/admin/planner', icon: 'clipboard', desc: 'Pack project tracking' },
          { label: 'Resources', href: '/admin/resources', icon: 'folder', desc: 'Forms, links & tools' },
          { label: 'Scoutbook', href: 'https://scoutbook.scouting.org', icon: 'external', desc: 'Advancement tracking' },
          { label: 'my.Scouting', href: 'https://my.scouting.org', icon: 'external', desc: 'Training & registration' },
          { label: 'Public Site', href: '/', icon: 'globe', desc: 'View parent-facing site' },
        ].map(({ label, href, icon, desc }) => (
          <a href={href} target={icon === 'external' ? '_blank' : undefined} rel={icon === 'external' ? 'noopener' : undefined}
            class="flex flex-col gap-1 p-3 border border-gray-200 rounded-lg hover:bg-scout-blue-pale hover:border-scout-blue transition-colors group">
            <span class="text-sm font-medium text-gray-800 group-hover:text-scout-blue flex items-center gap-1">
              {label}
              {icon === 'external' && (
                <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              )}
            </span>
            <span class="text-xs text-gray-400">{desc}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Important reminders -->
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden md:col-span-2">
      <div class="px-4 py-3 border-b border-gray-100">
        <h3 class="font-semibold text-gray-900">Leader Reminders</h3>
      </div>
      <div class="p-4">
        <ul class="space-y-3">
          {[
            { type: 'warning', text: 'Youth Protection Training (YPT) must be renewed annually. Check your expiration at my.scouting.org.' },
            { type: 'info', text: 'Two-deep leadership required at ALL scout activities — in person and virtual.' },
            { type: 'info', text: 'Record advancement completions in Scoutbook promptly after each meeting.' },
            { type: 'warning', text: 'All expenditures over $50 require committee approval before purchasing.' },
          ].map(({ type, text }) => (
            <li class={`flex items-start gap-3 text-sm rounded-lg p-3 ${type === 'warning' ? 'bg-yellow-50 border border-yellow-200' : 'bg-blue-50 border border-blue-100'}`}>
              {type === 'warning' ? (
                <svg class="w-4 h-4 text-yellow-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              ) : (
                <svg class="w-4 h-4 text-blue-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
              <span class={type === 'warning' ? 'text-yellow-800' : 'text-blue-800'}>{text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

  </div>
</AdminLayout>
