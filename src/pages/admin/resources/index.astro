      { title: 'Cub Scout Program Resources', url: 'https://www.scouting.org/programs/cub-scouts/resources/', desc: 'Adventure requirements, leader guides, and program materials', icon: 'book' },
      { title: 'Insignia Guide', url: 'https://www.scouting.org/resources/insignia-guide/', desc: 'Official uniform and awards placement guide', icon: 'badge' },
      { title: 'Youth Protection Training', url: 'https://my.scouting.org/', desc: 'Complete required YPT at my.Scouting.org (annual requirement)', icon: 'shield' },
    ],
  },
  {
    section: 'Tools & Applications',
    items: [
      { title: 'Scoutbook', url: 'https://scoutbook.scouting.org/', desc: 'Track scout advancement, log activities, and communicate with families', icon: 'check' },
      { title: 'my.Scouting.org', url: 'https://my.scouting.org/', desc: 'Manage your registration, training, and leader position', icon: 'user' },
      { title: 'Internet Recharter', url: 'https://my.scouting.org/', desc: 'Manage annual pack recharter (via my.Scouting.org)', icon: 'refresh' },
      { title: 'Online Store', url: 'https://www.scoutshop.org/', desc: 'Official BSA merchandise, uniforms, and advancement awards', icon: 'cart' },
    ],
  },
  {
    section: 'Pack Forms & Templates',
    items: [
      { title: 'Annual Health & Medical Record (Parts A&B)', url: 'https://filestore.scouting.org/filestore/HealthSafety/pdf/680-001_AB.pdf', desc: 'Required for all scouts at day activities and meetings', icon: 'document' },
      { title: 'Annual Health & Medical Record (Part C)', url: 'https://filestore.scouting.org/filestore/HealthSafety/pdf/680-001_C.pdf', desc: 'Required for camping events over 72 hours (needs physician signature)', icon: 'document' },
      { title: 'Talent Release Form', url: 'https://filestore.scouting.org/filestore/mission/Marketing/pdf/512-827.pdf', desc: 'Photo and media release for scouts', icon: 'document' },
      { title: 'Tour and Activity Plan', url: 'https://scoutingevent.com/', desc: 'Required for trips over 500 miles or high-adventure activities', icon: 'map' },
    ],
  },
  {
    section: 'Training & Development',
    items: [
      { title: 'Den Leader Training (online)', url: 'https://my.scouting.org/', desc: 'Position-specific training for new den leaders', icon: 'academic' },
      { title: 'University of Scouting', url: 'https://www.scouting.org/training/', desc: 'Advanced training opportunities for experienced leaders', icon: 'academic' },
      { title: 'Wood Badge', url: 'https://www.scouting.org/training/adult/wood-badge/', desc: 'Premier leadership training for adult volunteers', icon: 'star' },
      { title: 'Baloo Training', url: 'https://my.scouting.org/', desc: 'Required for any leader taking cubs on overnight camping', icon: 'tent' },
    ],
  },
];

const iconPaths: Record<string, string> = {
